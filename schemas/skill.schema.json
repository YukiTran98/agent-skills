{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillEntry",
  "type": "object",
  "required": ["name", "display_name", "group", "tags", "description", "version", "author", "agents", "file"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Slug, unique, kebab-case"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "type": "string",
      "enum": ["GENERAL", "DA", "DE", "DS"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "semver"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["claude-code", "kiro"]
      },
      "minItems": 1
    },
    "file": {
      "type": "string",
      "description": "Relative path to SKILL.md"
    },
    "docs": {
      "type": "string",
      "description": "Relative path to docs file (optional)"
    }
  }
}
